# 复制成 .env 并填入真值。.env 已在 .gitignore 里。

# ── 应用 ────────────────────────────────────────────────
MP_ENV=dev
MP_PORT=9102
MP_HOST=127.0.0.1
MP_DATABASE_URL=sqlite:///data/myportal.db
# 前端允许的源（同源部署时不需要）
MP_ALLOWED_ORIGINS=http://127.0.0.1:6010,http://127.0.0.1:6012

# ── 认证 ────────────────────────────────────────────────
# 至少 32 字节。生产环境必须换掉默认值。
JWT_SECRET=change-me-to-a-random-32-byte-secret-at-minimum
ACCESS_TTL_MIN=15

# ── FortiSIEM（Fortinet 设备的事件通道）──────────────────
# API 凭据，不是 admin GUI 密码。GUI 上 Admin > Settings > System > API Token 铸造。
#
# **网络前提**：172.16.20.48 在内网，本机必须能路由过去 ——
# 插 USB IDC 网卡（静态 IP 172.16.0.12/24，网关 172.16.0.1），
# 或走 FortiClient SSL VPN（117.143.88.2:10443）。
# 连不上时 /health 会报 siem.connected=false 与原因，监控面板照常工作
# （设备显示灰色 = 不知道，不是有问题）。
#
# 已实测：VPN 网卡（以太网 3, 172.16.253.1/32）时 172.16.20.48:443
# TCP 0.02s、HTTP 401（端点在、只是要认证）、TLS 1.3 握手成功。
FORTISIEM_BASE_URL=https://172.16.20.48
FORTISIEM_CLIENT_ID=
FORTISIEM_CLIENT_SECRET=
FORTISIEM_ORG=Super
# 开发机证书是自签的，生产环境置 true
FORTISIEM_VERIFY_TLS=false
FORTISIEM_TIMEOUT=15
