# 复制成 .env 并填入真值。.env 已在 .gitignore 里。

# ── 应用 ────────────────────────────────────────────────
MP_ENV=dev
MP_PORT=9102
MP_HOST=127.0.0.1
MP_DATABASE_URL=sqlite:///data/myportal.db
# 前端允许的源（同源部署时不需要）
MP_ALLOWED_ORIGINS=http://127.0.0.1:6010,http://127.0.0.1:6012

# ── 认证 ────────────────────────────────────────────────
# 至少 32 字节。生产环境必须换掉默认值。
JWT_SECRET=change-me-to-a-random-32-byte-secret-at-minimum
ACCESS_TTL_MIN=15

# ── FortiSIEM（Fortinet 设备的事件通道）──────────────────
# API 凭据，不是 admin GUI 密码。GUI 上 Admin > Settings > System > API Token 铸造。
#
# **网络前提**：172.16.20.48 在内网，本机必须能路由过去 ——
# 插 USB IDC 网卡（静态 IP 172.16.0.12/24，网关 172.16.0.1），
# 或走 FortiClient SSL VPN（117.143.88.2:10443）。
# 连不上时 /health 会报 siem.connected=false 与原因，监控面板照常工作
# （设备显示灰色 = 不知道，不是有问题）。
#
# 已实测：VPN 网卡（以太网 3, 172.16.253.1/32）时 172.16.20.48:443
# TCP 0.02s、HTTP 401（端点在、只是要认证）、TLS 1.3 握手成功。
FORTISIEM_BASE_URL=https://172.16.20.48
# client_id 不是秘密，可以写进模板；client_secret 是 —— 留空，由使用者填
FORTISIEM_CLIENT_ID=712381cd-bbfe-4c51-8bd8-11070b655ce4
FORTISIEM_CLIENT_SECRET=
FORTISIEM_ORG=Super
# 开发机证书是自签的，生产环境置 true
FORTISIEM_VERIFY_TLS=false
FORTISIEM_TIMEOUT=15

# ── 实机验证记录（2026-11-21，FortiSIEM 7.5.1）────────────────
# 填好凭据后 /api/siem/status 的四段诊断应全绿：
#   tcp   172.16.20.48:443 可连接
#   tls   TLS 握手成功，HTTP 200
#   auth  token 获取成功（OAuth client_credentials，token 900 秒）
#   api   读到 3 台设备
#
# 严重度映射：**类别优先**。实机 (eventSeverityCat, eventSeverity) 是冲突的：
#   (6,'MEDIUM')  (7,'MEDIUM')  (9,'HIGH')
# 数值 9 看着像 critical，但 SIEM 自己判的是 HIGH —— 类别才是判定结果。
#
# 字段名与旧文档不同（7.5.1 实测）：
#   customer（不是 organization）、eventSeverityCat、incidentTitle、
#   incidentRptDevName、incidentRptIp、incidentSrc/incidentTarget（KV 串）
#
# naturalId 是 URL 编码的："HOST%2d1.1.1.1" —— 需要 unquote。
